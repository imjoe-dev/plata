{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plata",
      "database_id": "8493f43f-6fe1-4639-9ffe-7615092eac86",
      "migrations_dir": "drizzle",
    },
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "3",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "routes": [
    {
      "pattern": "plata.imjoe.dev",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
